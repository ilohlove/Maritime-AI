# Dedicated NEW Render Web Service: maritime-ai-staging-api
# Branch: feature/supabase-staging-preparation
# Root Directory: backend
# Build Command: python -m pip install .
# Start Command: uvicorn app.main:create_app --factory --host 0.0.0.0 --port ${PORT:-10000} --workers 1 --no-proxy-headers
# Set PYTHON_VERSION to a supported pinned Python 3.11+ version in Render.
# Disable auto deploy until reviewed. Do not apply to existing demo service.
# These values are placeholders, NEVER commit real credentials.

MARITIME_ENV=production
MARITIME_ONLINE_MVP_MODE=true
MARITIME_HTTPS_TRANSPORT=signed-gateway
MARITIME_AUTH_TRANSPORT=bearer
WEB_CONCURRENCY=1

# Same 64-character lowercase hex secret in new staging Worker secret store.
MARITIME_GATEWAY_SECRET=REPLACE_WITH_STAGING_GATEWAY_SECRET
MARITIME_ADMIN_USERNAME=admin
MARITIME_PASSWORD_HASH=REPLACE_WITH_STAGING_SCRYPT_HASH

# Use dedicated maritime_backend account, host AND db name, and verify-full TLS.
# Supply trusted Supabase Root CA through a secure provider-managed file and
# reference its path in the URL via sslrootcert (or PGSSLROOTCERT).
# URL-encode password reserved characters; do not copy the migration-only URL.
MARITIME_DATABASE_URL=postgresql+psycopg://REPLACE_BACKEND_USER:REPLACE_PASSWORD@REPLACE_POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=REPLACE_CA_PATH

MARITIME_STORAGE_BACKEND=s3
MARITIME_STORAGE_PERSISTENT=true
MARITIME_S3_PRIVATE_BUCKET=true
MARITIME_S3_ENDPOINT=https://REPLACE_WITH_EXACT_SUPABASE_S3_ENDPOINT
MARITIME_S3_REGION=ap-south-1
MARITIME_S3_BUCKET=maritime-ai-documents
MARITIME_S3_ACCESS_KEY=REPLACE_WITH_STAGING_ACCESS_KEY_ID
MARITIME_S3_SECRET_KEY=REPLACE_WITH_STAGING_SECRET_ACCESS_KEY

# Actual new Worker HTTPS origin and new Render hostname only.
MARITIME_ALLOWED_ORIGINS=https://maritime-ai-staging.REPLACE_ACCOUNT.workers.dev
MARITIME_TRUSTED_HOSTS=REPLACE_STAGING_SERVICE.onrender.com

# Initial deployment: no paid AI requests.
MARITIME_AI_ENABLED=false
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODELS=gpt-4.1-mini
OPENAI_MAX_RETRIES=0

# Do not set MARITIME_DISPOSABLE_TEST_MODE, MARITIME_DISPOSABLE_ACK,
# MARITIME_DISPOSABLE_ROOT, or MARITIME_TRUSTED_PROXY_IPS.
# Do not copy these placeholders directly into a live service.
