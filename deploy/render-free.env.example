# Render Free disposable profile. NOT deployment-ready: ingress trust is unresolved.
# See docs/RENDER_FREE_CONFIGURATION.md. Enter values individually in Render's UI.
MARITIME_ENV=production
MARITIME_DISPOSABLE_TEST_MODE=true
MARITIME_DISPOSABLE_ACK=SYNTHETIC_ONLY_DATA_LOSS_NO_PAID_AI
MARITIME_STORAGE_PERSISTENT=false
MARITIME_AUTH_TRANSPORT=bearer
MARITIME_ADMIN_USERNAME=admin
MARITIME_PASSWORD_HASH=REPLACE_WITH_LOCALLY_GENERATED_SCRYPT_HASH
OPENAI_API_KEY=DISABLED-DISPOSABLE-TEST
# Use this only for that actual frontend origin; replace if hosted elsewhere.
MARITIME_ALLOWED_ORIGINS=https://ilohlove.github.io
MARITIME_TRUSTED_HOSTS=REPLACE_WITH_ACTUAL_RENDER_SERVICE_HOSTNAME
MARITIME_BIND_HOST=0.0.0.0
WEB_CONCURRENCY=1
# Do not set PORT: start_backend.py consumes the PORT supplied by Render.
# Intentionally unset until verified; production startup must fail without it:
# MARITIME_TRUSTED_PROXY_IPS=<verified immediate ingress IPs/CIDRs>
# No real API keys, persistent disks or manually configured storage paths.
