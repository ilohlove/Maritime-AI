# Separate new service only. Never paste this over the live disposable environment.
MARITIME_ENV=production
MARITIME_ONLINE_MVP_MODE=true
MARITIME_DISPOSABLE_TEST_MODE=false
MARITIME_HTTPS_TRANSPORT=signed-gateway
MARITIME_GATEWAY_SECRET=REPLACE_WITH_NEW_64_LOWERCASE_HEX_BACKEND_SECRET
MARITIME_TRUSTED_PROXY_IPS=
MARITIME_BIND_HOST=0.0.0.0
WEB_CONCURRENCY=1
MARITIME_AUTH_TRANSPORT=bearer
MARITIME_ADMIN_USERNAME=admin
MARITIME_PASSWORD_HASH=REPLACE_WITH_OUTPUT_OF_scripts/hash_password.py
MARITIME_SESSION_SECONDS=3600
MARITIME_LOGIN_LIMIT=5
MARITIME_TRUSTED_HOSTS=REPLACE_NEW_BACKEND.onrender.com
MARITIME_ALLOWED_ORIGINS=https://REPLACE_NEW_WORKER.workers.dev
# URL-encode credentials. Use the Supabase session pooler and provider CA/system trust.
MARITIME_DATABASE_URL=postgresql+psycopg://maritime_backend.PROJECT:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=system
MARITIME_STORAGE_PERSISTENT=true
MARITIME_STORAGE_BACKEND=s3
# Obtain exact endpoint and region from the provider dashboard; no public bucket.
MARITIME_S3_ENDPOINT=https://PROJECT.storage.supabase.co/storage/v1/s3
MARITIME_S3_REGION=REPLACE_REGION
MARITIME_S3_BUCKET=maritime-private
MARITIME_S3_ACCESS_KEY=REPLACE_BACKEND_SECRET
MARITIME_S3_SECRET_KEY=REPLACE_BACKEND_SECRET
MARITIME_S3_PRIVATE_BUCKET=true
MARITIME_UPLOAD_RATE_LIMIT=3
MARITIME_MAX_DOCUMENTS=20
# Offline PDF/search/profile features need no OpenAI key or inference activation.
MARITIME_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODELS=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=0
MARITIME_AI_RATE_LIMIT=5
MARITIME_AI_CONCURRENCY=1
MARITIME_AI_DAILY_TOKEN_BUDGET=100000
MARITIME_AI_MAX_INPUT_TOKENS=20000
MARITIME_AI_OUTPUT_TOKENS=2000
MARITIME_AI_TRANSLATION_TOKENS=512
# Illustrative estimates only; verify model prices before separately authorizing AI.
MARITIME_AI_INPUT_USD_PER_MILLION=0.40
MARITIME_AI_OUTPUT_USD_PER_MILLION=1.60
