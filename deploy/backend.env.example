# Example only. Configure through the host's secret/environment settings.
MARITIME_ENV=production
MARITIME_ADMIN_USERNAME=admin
# Generate interactively with python scripts/hash_password.py. Never use a plaintext password here.
MARITIME_PASSWORD_HASH=REPLACE_WITH_GENERATED_SCRYPT_HASH
OPENAI_API_KEY=REPLACE_USING_HOST_SECRET_STORE
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODELS=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=0
MARITIME_AUTH_TRANSPORT=bearer
MARITIME_SESSION_SECONDS=3600
MARITIME_ALLOWED_ORIGINS=https://ilohlove.github.io
MARITIME_TRUSTED_HOSTS=api.example.invalid
# Both directories must be on a mounted durable local filesystem, not the container layer.
MARITIME_DATABASE_URL=sqlite:////var/lib/maritime/maritime.db
MARITIME_DOCUMENTS_DIR=/var/lib/maritime/originals
MARITIME_STORAGE_PERSISTENT=true
MARITIME_LOGIN_LIMIT=5
MARITIME_AI_RATE_LIMIT=5
MARITIME_AI_CONCURRENCY=1
MARITIME_AI_DAILY_TOKEN_BUDGET=100000
MARITIME_AI_MAX_INPUT_TOKENS=20000
MARITIME_AI_OUTPUT_TOKENS=2000
MARITIME_AI_TRANSLATION_TOKENS=512
WEB_CONCURRENCY=1
# Replace with the actual TLS ingress IP/CIDR; never '*'. Ingress must replace spoofed headers.
MARITIME_TRUSTED_PROXY_IPS=REPLACE_WITH_INGRESS_IP_OR_CIDR
# Loopback by default. Set 0.0.0.0 only on a host whose ingress/network is secured.
MARITIME_BIND_HOST=127.0.0.1
PORT=8000
