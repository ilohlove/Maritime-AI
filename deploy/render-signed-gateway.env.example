# Selected disposable architecture: Cloudflare Worker Free -> HTTPS -> Render Free.
# See docs/SIGNED_CLOUD_GATEWAY.md. No real secrets belong in this file.
MARITIME_ENV=production
MARITIME_HTTPS_TRANSPORT=signed-gateway
MARITIME_GATEWAY_SECRET=REPLACE_WITH_UNIQUE_64_LOWERCASE_HEX_SECRET
MARITIME_DISPOSABLE_TEST_MODE=true
MARITIME_DISPOSABLE_ACK=SYNTHETIC_ONLY_DATA_LOSS_NO_PAID_AI
MARITIME_STORAGE_PERSISTENT=false
MARITIME_AUTH_TRANSPORT=bearer
MARITIME_ADMIN_USERNAME=admin
MARITIME_PASSWORD_HASH=REPLACE_WITH_LOCALLY_GENERATED_SCRYPT_HASH
OPENAI_API_KEY=DISABLED-DISPOSABLE-TEST
MARITIME_ALLOWED_ORIGINS=https://maritime-ai-gateway.REPLACE-WITH-ACCOUNT.workers.dev
MARITIME_TRUSTED_HOSTS=REPLACE-WITH-ACTUAL.onrender.com
MARITIME_BIND_HOST=0.0.0.0
WEB_CONCURRENCY=1
# DELETE MARITIME_TRUSTED_PROXY_IPS. Do not replace it with any range or '*'.
# PORT is supplied by Render. Storage paths are created by the disposable launcher.
