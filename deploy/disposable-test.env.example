# REFERENCE ONLY — NOT DEPLOYED. Verify provider free terms and Pages login policy first.
MARITIME_ENV=production
MARITIME_DISPOSABLE_TEST_MODE=true
MARITIME_DISPOSABLE_ACK=SYNTHETIC_ONLY_DATA_LOSS_NO_PAID_AI
MARITIME_STORAGE_PERSISTENT=false
MARITIME_AUTH_TRANSPORT=bearer
MARITIME_ADMIN_USERNAME=admin
MARITIME_PASSWORD_HASH=GENERATE_UNIQUE_OWNER_HASH_IN_BACKEND_SECRET_STORE
# A deliberate noncredential. Real keys are rejected, and no SDK calls are allowed.
OPENAI_API_KEY=DISABLED-DISPOSABLE-TEST
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODELS=gpt-4.1-mini
OPENAI_MAX_RETRIES=0
OPENAI_TIMEOUT_SECONDS=15
MARITIME_AI_CONCURRENCY=1
MARITIME_AI_RATE_LIMIT=1
MARITIME_AI_DAILY_TOKEN_BUDGET=45000
MARITIME_AI_MAX_INPUT_TOKENS=20000
MARITIME_AI_TRANSLATION_TOKENS=128
MARITIME_AI_OUTPUT_TOKENS=256
MARITIME_ALLOWED_ORIGINS=https://ilohlove.github.io
MARITIME_TRUSTED_HOSTS=REPLACE_WITH_VERIFIED_BACKEND_DOMAIN
MARITIME_TRUSTED_PROXY_IPS=REPLACE_WITH_VERIFIED_INGRESS_IPS
MARITIME_BIND_HOST=127.0.0.1
PORT=8000
WEB_CONCURRENCY=1
# start_disposable_test.py sets ROOT, DATABASE_URL and DOCUMENTS_DIR to a fresh temp root.
# Do not point it at an operational database or claim persistence.
